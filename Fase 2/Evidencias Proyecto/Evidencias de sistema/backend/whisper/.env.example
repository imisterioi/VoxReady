# Configuración del servicio de transcripción (Whisper local).
#
# Cópialo como `.env` junto a server.py; si prefieres no usarlo, define las mismas
# variables en el entorno (PowerShell: $env:WHISPER_DEVICE = 'cpu'). Todas son
# opcionales: el servicio arranca con los valores por defecto que aparecen aquí.
# El archivo .env solo se lee si `python-dotenv` está instalado.

# --- Modelos -----------------------------------------------------------------
# Modelo que se usa cuando /transcribe no indica ?model= (compatibilidad).
WHISPER_MODEL=base
# Modelos disponibles. Por defecto: el anterior + small + medium.
WHISPER_MODELS=base,small,medium
# Repositorio de HuggingFace o ruta local de un modelo concreto.
#WHISPER_SMALL_MODEL=small
#WHISPER_BASE_MODEL=base
#WHISPER_MEDIUM_MODEL=medium

# --- Decodificación por modelo (afinar Small sin tocar Base) -------------------
# Idioma: 'es' para las pruebas en español; vacío = autodetectar.
WHISPER_LANGUAGE=es
# Búsqueda (beam). Base conserva 1; Small usa 5 por defecto (medido: más preciso en
# audio difícil y ~10 % más lento en audio limpio).
# Para forzar el mismo valor en todos los modelos: WHISPER_BEAM_SIZE=1
#WHISPER_BEAM_SIZE=1
#WHISPER_SMALL_BEAM_SIZE=5
# Whisper Medium (el más preciso y el más lento): misma decodificación que Small.
#WHISPER_MEDIUM_BEAM_SIZE=5
#WHISPER_MEDIUM_VAD_MIN_SILENCE_MS=500
#WHISPER_MEDIUM_VAD_SPEECH_PAD_MS=600
# Filtro de voz (VAD): recorta silencios. Base conserva el comportamiento anterior;
# Small usa más margen para no cortar palabras al inicio/final de la respuesta.
WHISPER_VAD=true
#WHISPER_BASE_VAD_MIN_SILENCE_MS=
#WHISPER_SMALL_VAD_MIN_SILENCE_MS=500
#WHISPER_SMALL_VAD_SPEECH_PAD_MS=600
# Contexto inicial (vocabulario de VoxReady). DESACTIVADO por defecto: en las mediciones
# no aportó mejora de WER y, si se desactiva el VAD, inventa texto en audio sin voz.
# Para probarlo con grabaciones reales, descomenta una línea y compara con eval_whisper.py.
#WHISPER_SMALL_INITIAL_PROMPT=Vocero, comunicación de crisis, declaración institucional, mensajes clave, organización, entrevista y gestión de crisis

# --- Cómputo (equipo de referencia: 16 GB de RAM y GTX 1050 Ti) ---------------
# En CPU (int8) Base y Small conviven en RAM sin problema (~0,5 GB cada uno).
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Con GPU, evita tener los dos modelos en la tarjeta a la vez:
#   WHISPER_SMALL_DEVICE=cuda
#   WHISPER_SMALL_COMPUTE_TYPE=float16
#   WHISPER_SINGLE_MODEL_IN_MEMORY=true   (libera el anterior antes de cargar el otro)
WHISPER_SINGLE_MODEL_IN_MEMORY=false
# Transcripciones simultáneas (1 = en serie, recomendado para no saturar CPU/GPU).
WHISPER_MAX_CONCURRENCY=1
# true = cargar TODOS los modelos al arrancar: la descarga de Small ocurre una sola
# vez al iniciar el servicio, fuera de la petición del laboratorio.
WHISPER_PRELOAD_ALL=false

# --- Audio -------------------------------------------------------------------
WHISPER_LANGUAGE=es
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true
WHISPER_MAX_MB=25
WHISPER_MAX_AUDIO_SECONDS=600

# --- Modelos y red -----------------------------------------------------------
# Carpeta alternativa para los modelos (por defecto, la caché de HuggingFace).
#WHISPER_MODEL_DIR=C:\voxready-modelos
# true = no descargar nada de Internet. Si falta un modelo, /health lo informa y
# /transcribe responde 503 con el motivo.
WHISPER_LOCAL_FILES_ONLY=false

# --- Servidor ----------------------------------------------------------------
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8001
