# Copia este archivo como .env.local y completa tu key de build.nvidia.com
NVIDIA_API_KEY=
AI_MODEL=deepseek-ai/deepseek-v4.1-flash
AI_FALLBACK_MODEL=google/gemma-4-31b-it
AI_TIMEOUT_MS=20000
# Secreto para firmar sesiones (cualquier texto largo y aleatorio)
AUTH_SECRET=
# IA evaluadora (informe)
AI_EVAL_MODEL=moonshotai/kimi-k3
AI_EVAL_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# Más modelos de respaldo para el entrevistador (se consultan en paralelo)
AI_EXTRA_MODELS=moonshotai/kimi-k3,nvidia/nemotron-3-super-120b-a12b
