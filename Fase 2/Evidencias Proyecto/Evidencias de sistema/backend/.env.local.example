# Copia este archivo como .env.local y completa tu key de build.nvidia.com
NVIDIA_API_KEY=
AI_MODEL=deepseek-ai/deepseek-v4.1-flash
AI_FALLBACK_MODEL=google/gemma-4-31b-it
AI_TIMEOUT_MS=20000
# Secreto para firmar sesiones (cualquier texto largo y aleatorio)
AUTH_SECRET=
# IA evaluadora (informe)
AI_EVAL_MODEL=moonshotai/kimi-k3
AI_EVAL_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# Más modelos de respaldo para el entrevistador (se consultan en paralelo)
AI_EXTRA_MODELS=moonshotai/kimi-k3,nvidia/nemotron-3-super-120b-a12b
# Laboratorio de transcripción (experimental): servicio Whisper local.
# Con el servicio en la misma máquina que el backend: http://127.0.0.1:8001
# Con Whisper en Docker y el backend en Windows: usa el puerto publicado del contenedor,
# por ejemplo http://127.0.0.1:8001 (docker run -p 8001:8001 ...). Dentro de un contenedor,
# "127.0.0.1" apunta al propio contenedor, no al host: ahí se usa http://host.docker.internal:8001.
WHISPER_URL=http://127.0.0.1:8001
# Tamaño máximo y tiempo máximo del audio reenviado al servicio
LAB_TRANSCRIBE_MAX_MB=25
# 5 min por defecto: Whisper Medium en CPU (int8, beam 5) tarda más que tiempo real
# (~1,3x en las mediciones del laboratorio), así que una respuesta larga necesita margen.
LAB_TRANSCRIBE_TIMEOUT_MS=300000

# --- Verificación del WPM con el audio de la sesión (evaluación) -----------------------
# La evaluación transcribe la pista de audio (<id>.audio.webm) y calcula el WPM con las
# marcas temporales por palabra. Sin audio verificado, el criterio de velocidad queda
# EXCLUIDO del cálculo (no vale 0 ni 100) y se registra el motivo.
EVAL_WHISPER_ENABLED=true
EVAL_WHISPER_MODEL=small
# Tope de tiempo de una transcripción (ms) y tamaño máximo de la pista de audio (MB).
EVAL_WHISPER_TIMEOUT_MS=120000
EVAL_WHISPER_MAX_MB=15
# Transcripciones simultáneas y cola de espera (por encima de la cola se devuelve BUSY).
EVAL_WHISPER_CONCURRENCY=1
EVAL_WHISPER_MAX_QUEUE=2
# Tamaños máximos de las subidas de la sesión (MB).
EVAL_MAX_VIDEO_MB=200
EVAL_MAX_AUDIO_MB=10
# Si una evaluación se queda "en curso" más de esto (ms), se considera interrumpida y
# el usuario puede reintentarla (útil tras un reinicio del backend).
EVAL_STALE_MS=900000
