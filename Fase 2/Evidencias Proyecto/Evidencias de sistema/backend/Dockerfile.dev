# Imagen de DESARROLLO del backend (Express + Prisma).
# - Las dependencias se instalan en la imagen; en runtime el código se monta desde el host
#   y node_modules se conserva en un volumen anónimo (los binarios de Prisma son de Linux).
# - nodemon vigila los cambios y reinicia el proceso (--legacy-watch = sondeo, fiable con
#   bind mounts de Windows).
FROM node:22-bookworm-slim

WORKDIR /app

# Prisma necesita OpenSSL en Debian slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

# El laboratorio NVIDIA ejecuta su cliente oficial de Riva como proceso hijo. Sin Python
# dentro del contenedor, `spawn` falla con ENOENT (PYTHON_MISSING) y toda llamada acaba en
# error. Se instala aquí, en la imagen, para que el entorno sea reproducible.
# Versiones fijadas: las mismas verificadas en el anfitrión (Debian 12 trae Python 3.11).
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip \
  && rm -rf /var/lib/apt/lists/* \
  && pip3 install --no-cache-dir --break-system-packages \
    "nvidia-riva-client==2.27.0" \
    "av==18.1.0" \
    "numpy>=1.26,<3"

# Ruta absoluta del intérprete dentro del contenedor (sobreescribible sin tocar código).
ENV PYTHON_EXECUTABLE=/usr/bin/python3

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY prisma ./prisma
RUN npx prisma generate

COPY . .

ENV NODE_ENV=development
EXPOSE 3000

CMD ["npm", "run", "dev"]
