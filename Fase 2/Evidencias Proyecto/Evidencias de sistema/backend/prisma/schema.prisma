// Configuración base
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Cliente (Tenant)
model Tenant {
  id        String   @id @default(uuid())
  name      String
  sector    String?
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED | DELETING
  createdAt DateTime @default(now())

  // Eliminación manual en curso (estado DELETING): momento en que se solicitó.
  // Permite reintentar la eliminación tras reinicios (estado persistente).
  deletionRequestedAt DateTime?

  // Política de retención (la define el admin del cliente)
  retentionMode String @default("FULL") // FULL = video + métricas | METRICS = solo métricas
  retentionDays Int    @default(90)

  // Cambio de plan PROGRAMADO (persistente): se aplica cuando llega `retentionEffectiveAt`.
  // Permite que un cambio de plan no altere retroactivamente las sesiones que ya están bajo el
  // plan vigente (ver lib/retentionPlan.js). null = no hay cambio pendiente.
  retentionModePending String?
  retentionDaysPending Int?
  retentionEffectiveAt DateTime?

  // Estilo de la plataforma (lo define el admin del cliente). null = colores de VoxReady
  brandColor  String? // Color principal, formato #RRGGBB
  accentColor String? // Color de acento, formato #RRGGBB

  users    User[]
  themes   Theme[]
  sessions Session[]

  deletionRequests DeletionRequest[]

  // Solicitudes de extensión del plazo de conservación (operación distinta a las de privacidad)
  retentionExtensionRequests RetentionExtensionRequest[]
}

// 2. Usuario (Vocero, Admin, Maestro)
model User {
  id    String @id @default(uuid())
  email String @unique
  name  String
  role  String @default("VOCERO") // VOCERO | ADMIN | MASTER | SYSTEM

  // Acceso
  passwordHash String?
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED
  area         String? // Público interno del vocero (Dirección, Planta, Técnicos)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  // Anonimización (Bloque A): si tiene fecha, el vocero fue anonimizado
  // (name/email/area sin PII, sin password) pero el registro y su histórico se conservan
  anonymizedAt DateTime?

  // El staff de VoxReady (MASTER y SYSTEM) no pertenece a una organización
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  sessions       Session[]
  assignments    ScenarioAssignment[]
  masterPatterns MasterPattern[]

  // Patrón de evaluación excepcional para este vocero (lo asigna el configurador maestro)
  patternOverride VoceroPatternOverride?

  // Solicitudes de borrado (creadas / dirigidas a / resueltas por)
  deletionRequestsMade     DeletionRequest[] @relation("DeletionRequestedBy")
  deletionRequestsTargeted DeletionRequest[] @relation("DeletionRequestTarget")
  deletionRequestsResolved DeletionRequest[] @relation("DeletionRequestResolvedBy")

  // Solicitudes de extensión del plazo de retención (creadas / resueltas por)
  retentionExtensionsMade     RetentionExtensionRequest[] @relation("RetentionExtensionRequestedBy")
  retentionExtensionsResolved RetentionExtensionRequest[] @relation("RetentionExtensionResolvedBy")

  // Intervalos en que la retención de este usuario estuvo PAUSADA
  // (por suspensión propia y/o de su tenant; se registra la unión, sin solapamientos)
  retentionPauses RetentionPause[]
}

// 3. Tema / Escenario
model Theme {
  id          String   @id @default(uuid())
  title       String
  context     String   @db.Text
  keyMessages String   @db.Text
  category    String   @default("GENERAL")

  optic       String?
  publics     String?
  redLines    String?

  availableToAllVoceros Boolean @default(false)

  // Borrado lógico: un tema "eliminado" deja de estar disponible pero conserva
  // su histórico (asignaciones, sesiones, informes y videos)
  deletedAt DateTime?

  // Escenario general de la biblioteca de VoxReady: no pertenece a ninguna
  // organización (tenantId vacío) y lo ven todos los voceros
  isGlobal Boolean @default(false)

  // Configuración de la entrevista (ver ai/interviewConfig.js): nivel de agresividad,
  // cantidad de preguntas y repreguntas, tiempo estimado, quién entrevista y tiempo por respuesta.
  // null = valores por defecto
  interviewConfig Json?

  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  sessions     Session[]
  assignments  ScenarioAssignment[]

  // Patrón de evaluación excepcional para este escenario (lo asigna el configurador maestro)
  patternOverride PatternOverride?

  @@unique([tenantId, title])
}

// 4. Asignación de un escenario a un vocero
model ScenarioAssignment {
  id String @id @default(uuid())

  status      String          @default("PENDING")
  assignedAt  DateTime        @default(now())
  completedAt DateTime?
  rubric      ScenarioRubric?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])

  @@unique([userId, themeId])
}

// 5. Sesión de práctica
model Session {
  id        String   @id @default(uuid())
  status    String   @default("CREATED")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Resultado de la práctica
  completedAt DateTime?
  transcript  Json? // Preguntas y respuestas de la entrevista
  metrics     Json? // Métricas de voz, cuerpo e iluminación medidas en el navegador
  report      Json? // Informe generado por la IA evaluadora
  score       Int? // Puntaje global 0-100
  review      Json? // Segunda opinión del experto (cola de etiquetado)

  // Auditoría técnica de la transcripción por respuesta (una fila por turno).
  transcriptionAudits TranscriptionAudit[]

  // Reintentos automáticos de evaluación (aditivo: 0/null/false en sesiones históricas).
  // Permiten recuperar el trabajo tras un reinicio y evitar que el vocero tenga que actuar.
  evalAttempts    Int       @default(0) // ejecuciones de evaluación consumidas (persistente)
  evalNextAt      DateTime? // próximo intento programado (null = ninguno)
  evalLeaseUntil  DateTime? // exclusión entre procesos/instancias mientras hay un intento vivo
  evalLastError   String? // código interno del último fallo (nunca contenido del vocero)
  evalFinishedAt  DateTime? // fin del último intento
  evalExhausted   Boolean   @default(false) // 50 intentos agotados: requiere intervención técnica

  @@index([evalNextAt])
}

// Auditoría de transcripción ASR por respuesta. No sustituye al transcript: guarda qué
// motor produjo el texto, qué intentos hubo y por qué se eligió (o por qué falló todo).
model TranscriptionAudit {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Índice del turno dentro de Session.transcript (los identificadores reales de la sesión).
  turnIndex Int

  status     String // ok | failed
  engine     String? // motor seleccionado (nvidia-whisper-large-v3 | nvidia-canary-1b | local-whisper-small)
  transcript String? // texto del motor elegido (se borra con la retención y con la anonimización)
  totalMs    Int?
  reason     String? // motivo de la selección o del fallo (código, no texto libre del proveedor)
  attempts   Json? // [{ engine, status, ms, code, chars }] — sin duplicar transcripciones

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, turnIndex]) // idempotencia: una auditoría final por sesión y turno
  @@index([sessionId])
}

// 6. Patrón maestro de evaluación
model MasterPattern {
  id      String @id @default(uuid())
  version Int    @default(1)
  status  String @default("ACTIVE")

  expressionWeight Int
  voiceToneWeight  Int
  coherenceWeight  Int
  empathyWeight    Int

  empathyLevel       String
  empathyDescription String @db.Text

  // Configuración detallada: criterios y rangos por área, descriptores para la IA
  name   String?
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  scenarioRubrics ScenarioRubric[]
  overrides       PatternOverride[]
  voceroOverrides VoceroPatternOverride[]
}

// 8. Patrón excepcional para un escenario concreto (de una organización)
model PatternOverride {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  patternId String
  pattern   MasterPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  themeId String @unique
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
}

// 7. Rubrica de escenario
model ScenarioRubric {
  id String @id @default(uuid())

  expressionWeight Int
  voiceToneWeight  Int
  coherenceWeight  Int
  empathyWeight    Int

  empathyLevel       String
  empathyDescription String @db.Text

  manuallyModified Boolean @default(false)

  masterPatternId      String?
  masterPatternVersion Int?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentId  String             @unique
  assignment    ScenarioAssignment @relation(fields: [assignmentId], references: [id])
  masterPattern MasterPattern?     @relation(fields: [masterPatternId], references: [id])
}

// 9. Patrón excepcional para un vocero concreto (p. ej. dificultades del habla:
//    más peso a lo visual). Tiene prioridad sobre el patrón del escenario.
model VoceroPatternOverride {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  patternId String
  pattern   MasterPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 10. Solicitud de borrado de datos de una organización (retención / derecho al olvido).
// Flujo de estados: PENDING → APPROVED | REJECTED → COMPLETED (al completar se ejecuta el borrado).
model DeletionRequest {
  id String @id @default(uuid())

  // Qué se solicita borrar: RECORDINGS = grabaciones (videos) de un vocero
  scope  String  @default("RECORDINGS")
  reason String?

  // PENDING | APPROVED | REJECTED | COMPLETED
  status String @default("PENDING")

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  resolutionNote String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("DeletionRequestedBy", fields: [requestedById], references: [id])

  // Vocero cuyos datos se solicitan borrar (opcional)
  targetUserId String?
  targetUser   User?   @relation("DeletionRequestTarget", fields: [targetUserId], references: [id])

  resolvedById String?
  resolvedBy   User?   @relation("DeletionRequestResolvedBy", fields: [resolvedById], references: [id])
}

// 10.b Solicitud de EXTENSIÓN del plazo de conservación.
//
// Es una operación DISTINTA a las solicitudes de privacidad (que borran o anonimizan): aquí el
// admin del cliente pide conservar durante más tiempo los datos que ya existen y el
// administrador del sistema la aprueba o rechaza. Al aprobarla se aplica de INMEDIATO
// (retentionDays pasa al plazo solicitado), sin esperar una fecha efectiva, para que el proceso
// automático de retención no borre los datos que la extensión protege.
model RetentionExtensionRequest {
  id String @id @default(uuid())

  // PENDING | APPROVED | REJECTED  (aprobada = aplicada; no hay paso intermedio)
  status String @default("PENDING")

  reason String?
  currentDays   Int // plazo vigente en el momento de solicitarla
  requestedDays Int // plazo solicitado (debe ser mayor que el vigente)
  appliedDays   Int? // plazo realmente aplicado al aprobar (trazabilidad)

  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("RetentionExtensionRequestedBy", fields: [requestedById], references: [id])

  resolvedById String?
  resolvedBy   User?  @relation("RetentionExtensionResolvedBy", fields: [resolvedById], references: [id])

  @@index([tenantId, status])
}

// 11. Intervalo de pausa de la retención de un usuario (por suspensión del vocero
// y/o de su tenant). La unión de intervalos de un usuario no se solapa: se abre un
// intervalo cuando el usuario queda efectivamente suspendido y se cierra cuando deja
// de estarlo (vocero y tenant activos). Permite reconstruir el tiempo de retención real.
model RetentionPause {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, endedAt])
}

// 12. Historial de cambios de estado de las organizaciones (métricas de clientes
// ganados y perdidos). No tiene relación con Tenant ni guarda su nombre: el registro
// sobrevive a la eliminación de la organización sin conservar datos del cliente.
model TenantEvent {
  id       String   @id @default(uuid())
  tenantId String
  type     String // SUSPENDED | REACTIVATED | DELETED
  at       DateTime @default(now())

  // Fecha de creación de la organización (para saber si se ganó y perdió en el mismo período)
  tenantCreatedAt DateTime?

  @@index([type, at])
}

