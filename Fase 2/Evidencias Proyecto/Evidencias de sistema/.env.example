# VoxReady — variables del entorno de DESARROLLO con Docker Compose.
# Copia este archivo como `.env` (ignorado por git) y ajusta los valores.
# NO subas el `.env` real al repositorio.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=voxready_db
# Puerto publicado en el host (5433 si ya usas un PostgreSQL local en 5432)
POSTGRES_PORT=5432

# Volumen EXISTENTE con los datos actuales. Solo cámbialo si sabes qué haces:
# dos servidores PostgreSQL no pueden compartir el mismo directorio de datos.
PGDATA_VOLUME=f79952eb178cad11cfcb7a48e122c1b00c21eb96e46fdef5bb9b8839dca7f389

# --- Puertos del host ---------------------------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=5173
WHISPER_PORT=8001

# --- Frontend -----------------------------------------------------------------
# Lo usa el NAVEGADOR: debe apuntar al puerto publicado del backend.
VITE_API_URL=http://localhost:3000

# --- Whisper ------------------------------------------------------------------
# Caché de modelos del host (evita descargarlos en cada arranque).
# Windows: usa barras normales y tu usuario real.
HF_CACHE=C:/Users/tu-usuario/.cache/huggingface
WHISPER_MODELS=base,small,medium
WHISPER_MODEL=base
WHISPER_MAX_MB=25
WHISPER_MAX_AUDIO_SECONDS=600
WHISPER_MAX_CONCURRENCY=1
