// Configuración base
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Cliente (Tenant)
model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  themes   Theme[]
  sessions Session[]
}

// 2. Usuario (Vocero, Admin, Maestro)
model User {
  id    String @id @default(uuid())
  email String @unique
  name  String
  role  String @default("VOCERO")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  sessions    Session[]
  assignments ScenarioAssignment[]
}

// 3. Tema / Escenario
model Theme {
  id          String @id @default(uuid())
  title       String
  context     String @db.Text
  keyMessages String @db.Text
  category    String @default("GENERAL")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  sessions    Session[]
  assignments ScenarioAssignment[]
}

// 4. Asignación de un escenario a un vocero
model ScenarioAssignment {
  id String @id @default(uuid())

  status      String    @default("PENDING")
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])

  @@unique([userId, themeId])
}

// 5. Sesión de práctica
model Session {
  id        String   @id @default(uuid())
  status    String   @default("CREATED")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
}
